<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="2.88.9" />
    <ProjectReference Include="..\RaceVideoProcessor.Core\RaceVideoProcessor.Core.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- The scoreboard's own typefaces, exactly as the design HTML loads them from
         Google Fonts: Orbitron 700 and Noto Sans Tamil 500 (Tamil and Latin subsets). OFL. -->
    <None Include="Fonts\Scoreboard\*.*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fonts\Scoreboard" />
  </ItemGroup>
  <ItemGroup>
    <!-- Font resolution and coverage are tested against synthetic font files. -->
    <InternalsVisibleTo Include="RaceVideoProcessor.Tests" />
  </ItemGroup>
</Project>
