<UserControl x:Class="RaceVideoProcessor.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Logs" Style="{StaticResource Txt.Title}" />
            <TextBlock Text="Technical detail lives here so the work screen stays clear. The same lines are written to the log file on disk."
                       Style="{StaticResource Txt.Muted}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,14">
            <Button Content="OPEN LOG FILE" Command="{Binding OpenLogFileCommand}" Style="{StaticResource Btn.Secondary}" />
            <Button Content="CLEAR VIEW" Command="{Binding ClearLogsCommand}" Style="{StaticResource Btn.Secondary}" Margin="0" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="{StaticResource Radius.Card}" Padding="14">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}"
                     ItemContainerStyle="{StaticResource LogRow}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     VirtualizingStackPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{Binding Converter={StaticResource LogBrush}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</UserControl>
