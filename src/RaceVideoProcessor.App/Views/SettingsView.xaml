<UserControl x:Class="RaceVideoProcessor.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Settings by category. Race IDs are not here (they belong to Races), and the
         API type is not here (the category decides it: 200 Meter → 200, 300 Meter → 300). -->
    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Categories -->
        <Border Style="{StaticResource Card}" Padding="8" VerticalAlignment="Top" Margin="0,0,14,0">
            <StackPanel>
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="General"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="General"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=General}" />
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="Video Processing"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="VideoProcessing"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=VideoProcessing}" />
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="Upload / Server"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="UploadServer"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=UploadServer}" />
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="Application"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="Application"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Application}" />
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="System"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="System"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=System}" />
                <RadioButton Style="{StaticResource SideNavItem}" GroupName="Section" Content="Backup &amp; Restore"
                             Command="{Binding SetSettingsSectionCommand}" CommandParameter="Backup"
                             IsChecked="{Binding ActiveSettingsSection, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Backup}" />
            </StackPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="18" VerticalAlignment="Top">
                    <Grid MaxWidth="860" HorizontalAlignment="Left">

                        <!-- ===== GENERAL ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=General}">
                            <TextBlock Text="General" Style="{StaticResource Txt.Title}" />
                            <TextBlock Text="Sign-in for the race backend, and the workflow the application starts in." Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Login email" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.LoginEmail, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Login password" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <PasswordBox x:Name="PasswordInput" PasswordChanged="PasswordInput_PasswordChanged" Padding="11,8" FontSize="{StaticResource Size.Body}" />
                                    <TextBlock Text="Stored encrypted for this Windows user. Never logged or shown." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Processing" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding ProcessingEnabled, Mode=TwoWay}" Content="Add the scoreboard with FFmpeg before upload" />
                                    <TextBlock Text="The same switch as Processing in the header. OFF uploads the selected video as it is." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Upload" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding UploadEnabled, Mode=TwoWay}" Content="Upload the video and assign it to the player" />
                                    <TextBlock Text="The same switch as Upload in the header. Both apply to the next video and are remembered." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Test Login" Command="{Binding TestLoginCommand}" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Padding="14,7" />
                        </StackPanel>

                        <!-- ===== VIDEO PROCESSING ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=VideoProcessing}">
                            <TextBlock Text="Video Processing" Style="{StaticResource Txt.Title}" />
                            <TextBlock Text="Used only when Processing is ON." Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Hardware encoder" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding EncoderDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Button Content="Test NVENC" Command="{Binding TestNvencCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,5" />
                                    <Button Content="Test FFmpeg" Command="{Binding TestFfmpegCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,5" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Encoder" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding EncoderPreferences}" SelectedItem="{Binding Settings.EncoderPreference}" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Text="Auto uses NVIDIA NVENC when the GPU supports it and falls back to the CPU (x264)." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Quality" Style="{StaticResource FormLabel}" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding EncodingQualities}" SelectedItem="{Binding Settings.EncodingQuality}" Width="260" HorizontalAlignment="Left" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="File size" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding Settings.MatchSourceFileSize}" Content="Keep the processed file about the size of the original" />
                                    <TextBlock Text="Encodes at the source video's own bitrate. The size difference is written to the log after every video." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Overwrite outputs" Style="{StaticResource FormLabel}" />
                                <CheckBox Grid.Column="1" IsChecked="{Binding Settings.AllowOverwriteExistingOutput}" Content="Replace an existing processed file without asking" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Timing format" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Settings.TimingFormat, UpdateSourceTrigger=PropertyChanged}" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Text="How the closing timer writes the race time. mm:ss.ff turns 22.5 into 00:22.50." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Timer shown for" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Settings.CompletionTimeDisplaySeconds, UpdateSourceTrigger=PropertyChanged}" Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Text="Seconds at the end of the video. Default 4." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Scoreboard fonts" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding ScoreboardFontText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Fallback font" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding FontDisplay}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding Settings.FontFilePath, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                                    <TextBlock Text="Only used if the bundled scoreboard fonts are missing. Leave empty to find a Tamil font automatically." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ===== UPLOAD / SERVER ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=UploadServer}">
                            <TextBlock Text="Upload / Server" Style="{StaticResource Txt.Title}" />
                            <TextBlock Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" TextWrapping="Wrap"
                                       Text="{}{raceId} comes from the selected race, {}{type} from the category, {}{playerId} from the entry." />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Data source" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding DataSourceModes}" SelectedItem="{Binding Settings.DataSourceMode}" Width="260" HorizontalAlignment="Left" />
                                    <TextBlock Text="RealApi uses the backend below. Demo simulates entries, upload and assignment without any network." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Login URL" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.LoginUrl, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="200 m players URL" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.Players200UrlTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="300 m players URL" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.Players300UrlTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="200 m assign (PATCH) URL" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.Assign200UrlTemplate, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="300 m assign (PATCH) URL" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Settings.Assign300UrlTemplate, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Body: { videoLink, marker }." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Media upload URL" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Settings.MediaUploadUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="multipart/form-data, field upload, sent with the video's own filename." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ===== APPLICATION ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Application}">
                            <TextBlock Text="Application" Style="{StaticResource Txt.Title}" />
                            <TextBlock Text="How the application looks and refreshes." Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Application zoom" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="−" Command="{Binding ZoomOutCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,4" />
                                        <TextBlock Text="{Binding UiZoom, Converter={StaticResource ZoomPercent}}" FontWeight="Bold" VerticalAlignment="Center" Width="52" TextAlignment="Center" Margin="0,0,10,0" />
                                        <Button Content="+" Command="{Binding ZoomInCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,4" />
                                        <Button Content="Reset" Command="{Binding ResetZoomCommand}" Style="{StaticResource Btn.Link}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="75 % to 150 %. Also Ctrl +, Ctrl − and Ctrl 0. Affects this window only, never the video." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Check for new entries" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <ComboBox ItemsSource="{Binding PollingIntervals}" SelectedItem="{Binding Settings.PollingIntervalSeconds}" Width="120" HorizontalAlignment="Left" />
                                    <TextBlock Text="Seconds between checks. New entries join the list in date order without disturbing your work." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Demo entries" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <CheckBox IsChecked="{Binding Settings.DemoAutoAdvance}" Content="Release the next demo card automatically" />
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBox Text="{Binding Settings.DemoEntryIntervalSeconds, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                                        <TextBlock Text="seconds between demo cards" Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ===== SYSTEM ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=System}">
                            <TextBlock Text="System" Style="{StaticResource Txt.Title}" />
                            <TextBlock Text="Tools and folders on this computer." Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" />

                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="FFmpeg" Style="{StaticResource FormLabel}" />
                                <StackPanel Grid.Column="1">
                                    <TextBox Text="{Binding Settings.FfmpegPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="A bare name uses the bundled copy first, then PATH." Style="{StaticResource FormHelp}" />
                                </StackPanel>
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="FFprobe" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.FfprobePath, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Input video folder" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.InputVideoFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Open" Command="{Binding OpenInputFolderCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,5" Margin="10,0,0,0" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Processed video folder" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.OutputVideoFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Open" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,5" Margin="10,0,0,0" />
                            </Grid>
                            <Grid Style="{StaticResource Row}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="200" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Demo video folder" Style="{StaticResource FormLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Settings.DemoVideoFolder, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="Open" Command="{Binding OpenDemoVideoFolderCommand}" Style="{StaticResource Btn.Secondary}" Padding="12,5" Margin="10,0,0,0" />
                            </Grid>
                        </StackPanel>

                        <!-- ===== BACKUP & RESTORE ===== -->
                        <StackPanel Visibility="{Binding ActiveSettingsSection, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Backup}">
                            <TextBlock Text="Backup &amp; Restore" Style="{StaticResource Txt.Title}" />
                            <TextBlock Text="Races, entry states and settings live in one local SQLite database." Style="{StaticResource Txt.Muted}" Margin="0,2,0,16" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Back up database now" Command="{Binding BackupDatabaseCommand}" Padding="14,7" />
                                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource Btn.Secondary}" Padding="14,7" />
                            </StackPanel>
                            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource FormHelp}" />
                            <TextBlock Style="{StaticResource FormHelp}" Margin="0,14,0,0"
                                       Text="Restore: close the application, then replace race-video-processor.db in the data folder with a backup file (and delete the -wal and -shm files beside it). The application does not overwrite its live database while running." />
                        </StackPanel>
                    </Grid>
                </Border>
            </ScrollViewer>

            <Border Grid.Row="1" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="Changes apply after Save Settings, which also refreshes the entries." Style="{StaticResource Txt.Muted}"
                               VerticalAlignment="Center" Margin="0,0,14,0" />
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Padding="18,8" Margin="0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
