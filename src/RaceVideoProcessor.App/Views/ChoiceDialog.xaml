<Window x:Class="RaceVideoProcessor.App.Views.ChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560" SizeToContent="Height" MinHeight="200"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource Size.Body}"
        WindowStartupLocation="CenterOwner">

    <!-- A decision with named choices. Used where Yes/No would be ambiguous:
         replacing an existing video, and permanently deleting a race. -->
    <Border Margin="18" Style="{StaticResource Card}" x:Name="Frame">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Txt.Title}" TextWrapping="Wrap" />
            <TextBlock x:Name="BodyText" Style="{StaticResource Txt.Body}" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="WarningText" Style="{StaticResource BlockReason}" Margin="0,14,0,0" Visibility="Collapsed" />
            <WrapPanel x:Name="Buttons" HorizontalAlignment="Right" Margin="0,22,0,0" />
        </StackPanel>
    </Border>
</Window>
