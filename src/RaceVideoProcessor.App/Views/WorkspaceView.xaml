<UserControl x:Class="RaceVideoProcessor.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The work area. Left: the whole entry list. Right, top to bottom: the current
         entry, Select Video, Processing, Upload and the next entry. No page title and
         no preview: every pixel serves the operator's next action. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" MinWidth="250" MaxWidth="560" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="440" />
        </Grid.ColumnDefinitions>

        <!-- ======================= ENTRY LIST ======================= -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
            <Grid Margin="10,10,6,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status filters, each with its count -->
                <WrapPanel Margin="0,0,0,4">
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter"
                                 Command="{Binding SetFilterCommand}" CommandParameter="All"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=All}">
                        <TextBlock><Run Text="All" /> <Run Text="{Binding CountAll, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Uploaded"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Uploaded}">
                        <TextBlock><Run Text="Uploaded" /> <Run Text="{Binding CountUploaded, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Failed"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Failed}">
                        <TextBlock><Run Text="Failed" /> <Run Text="{Binding CountFailed, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter"
                                 Command="{Binding SetFilterCommand}" CommandParameter="ReadyToUpload"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=ReadyToUpload}">
                        <TextBlock><Run Text="Ready to Upload" /> <Run Text="{Binding CountReadyToUpload, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </RadioButton>
                    <RadioButton Style="{StaticResource FilterChip}" GroupName="Filter"
                                 Command="{Binding SetFilterCommand}" CommandParameter="Processing"
                                 IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Processing}">
                        <TextBlock><Run Text="Processing" /> <Run Text="{Binding CountProcessing, Mode=OneWay}" FontWeight="Bold" /></TextBlock>
                    </RadioButton>
                </WrapPanel>

                <!-- Search -->
                <Grid Grid.Row="1" Margin="0,2,4,8">
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,28,7" />
                    <TextBlock Text="⌕" FontSize="15" Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="11,0,0,2" />
                    <TextBlock Text="Search cart no or player name…" Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="31,0,0,0"
                               Visibility="{Binding SearchText, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                    <Button Content="✕" Command="{Binding ClearSearchCommand}" Style="{StaticResource Btn.Link}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Clear search"
                            Visibility="{Binding SearchText, Converter={StaticResource TextToVisibility}}" />
                </Grid>

                <TextBlock Grid.Row="2" Style="{StaticResource EmptyState}" VerticalAlignment="Top"
                           Text="{Binding EmptyListText}"
                           Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding VisibleEntries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource EntryRow}"
                         VirtualizingStackPanel.IsVirtualizing="True"
                         VirtualizingStackPanel.VirtualizationMode="Recycling"
                         Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- The real cart number (player.cartNo) is the identifier, so it leads. -->
                                <TextBlock Text="{Binding CardNumber}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource Text}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding PrimaryName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource Text}" ToolTip="{Binding PrimaryName}" />
                                    <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
                                               FontSize="{StaticResource Size.Small}" Margin="0,1,0,0"
                                               Visibility="{Binding HasPrimaryLocation, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="⌖" /> <Run Text="{Binding PrimaryLocation, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold" Margin="0,0,4,0"
                                               Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}" />
                                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Size.Small}" FontWeight="SemiBold"
                                               Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" Margin="0,8,4,0">
                    <Button Content="⟳  Refresh" Command="{Binding PollNowCommand}" Style="{StaticResource Btn.Secondary}"
                            Padding="12,5" HorizontalAlignment="Left" Margin="0" />
                    <TextBlock Text="{Binding EntryCountSummary}" Style="{StaticResource Txt.Muted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1" Width="3" Background="Transparent" />

        <!-- ======================= CURRENT ENTRY WORKFLOW ======================= -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12,16,14">

                <!-- Outcome banner -->
                <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                        Background="{Binding BannerSeverity, Converter={StaticResource BannerBrush}, ConverterParameter=soft}"
                        BorderBrush="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}"
                        Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}" />
                        <Button Grid.Column="1" Content="✕" Command="{Binding DismissBannerCommand}" Style="{StaticResource Btn.Link}"
                                Margin="12,0,0,0" ToolTip="Dismiss" />
                    </Grid>
                </Border>

                <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                        Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}"
                        Visibility="{Binding HasFontWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FontWarning}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" FontWeight="SemiBold" />
                </Border>

                <!-- ===== Current Entry ===== -->
                <Border Style="{StaticResource Card}" Padding="14">
                    <Grid>
                        <TextBlock Style="{StaticResource EmptyState}" Margin="8,18" Text="{Binding EmptyListText}"
                                   Visibility="{Binding HasCurrentEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <Grid DataContext="{Binding CurrentEntry}"
                              Visibility="{Binding DataContext.HasCurrentEntry, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" MinWidth="190" />
                            </Grid.ColumnDefinitions>

                            <!-- Cart -->
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="{StaticResource Radius.Control}"
                                    MinWidth="118" Padding="14,10" Margin="0,0,16,0">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Cart No." Style="{StaticResource Txt.Label}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding CardNumber}" Style="{StaticResource Txt.Card}" Foreground="{StaticResource AccentDark}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding StatusGlyph}" FontWeight="Bold" Margin="0,0,4,0"
                                                   Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource Size.Small}" FontWeight="SemiBold"
                                                   Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Players -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Primary Player" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding PrimaryName}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Text}" ToolTip="{Binding PrimaryName}" />
                                <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
                                           Visibility="{Binding HasPrimaryLocation, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="⌖" /> <Run Text="{Binding PrimaryLocation, Mode=OneWay}" />
                                </TextBlock>

                                <Border Style="{StaticResource Divider}" Margin="0,8" />

                                <TextBlock Text="Secondary Player" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding SecondaryName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource Text}" ToolTip="{Binding SecondaryName}" />
                                <TextBlock TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextMuted}"
                                           Visibility="{Binding HasSecondaryLocation, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="⌖" /> <Run Text="{Binding SecondaryLocation, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>

                            <Border Grid.Column="2" Width="1" Background="{StaticResource Border}" Margin="16,2" />

                            <!-- Race timing (timings) and entry time (date, else time) are different things -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="Race Timing" Style="{StaticResource Txt.Label}" />
                                <TextBlock Text="{Binding TimingSecondsText}" FontSize="22" FontWeight="Bold" Foreground="{StaticResource Text}" />
                                <TextBlock Text="Entry Time" Style="{StaticResource Txt.Label}" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding EntryDateDisplay}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Text}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ===== Select Video ===== -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Select Video" Style="{StaticResource Txt.Heading}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Select Video" Command="{Binding SelectVideoCommand}" Style="{StaticResource Btn.Primary}"
                                    Padding="20,9" FontSize="{StaticResource Size.Body}" />
                            <Border Grid.Column="1" Background="{StaticResource SurfaceAlt}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" CornerRadius="{StaticResource Radius.Control}" Padding="10,0,4,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedVideoText}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding CurrentEntry.LocalVideoPath}" />
                                    <Button Grid.Column="1" Content="✕" Command="{Binding ClearVideoCommand}" Style="{StaticResource Btn.Link}"
                                            Margin="6,0" VerticalAlignment="Center" ToolTip="Clear the selected video (no file is deleted)" />
                                </Grid>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding SelectVideoBlockReason}" Style="{StaticResource BlockReason}"
                                   Visibility="{Binding SelectVideoBlockReason, Converter={StaticResource TextToVisibility}}" />
                        <TextBlock Style="{StaticResource FormHelp}">
                            <Run Text="MP4, MOV, MKV, AVI, M4V, TS" /> <Run Text="·" /> <Run Text="{Binding WorkflowModeText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== Processing ===== -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Processing" Style="{StaticResource Txt.Heading}" />
                            <Button Content="■  Cancel Processing" Command="{Binding CancelProcessingCommand}" Style="{StaticResource Btn.Danger}"
                                    HorizontalAlignment="Right" Padding="12,5" Margin="0"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding ProcessingStateText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Text}" />

                        <!-- Real FFmpeg progress, and only while FFmpeg runs -->
                        <Grid Margin="0,8,0,0" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding JobPercent, Mode=OneWay}" Maximum="100"
                                         IsIndeterminate="{Binding JobPercentKnown, Converter={StaticResource InverseBool}}" />
                            <TextBlock Grid.Column="1" Text="{Binding JobPercentText}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Style="{StaticResource FormHelp}" Visibility="{Binding ProcessingStageDetail, Converter={StaticResource TextToVisibility}}">
                            <Run Text="Current stage:" FontWeight="SemiBold" /> <Run Text="{Binding ProcessingStageDetail, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource FormHelp}" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Elapsed" /> <Run Text="{Binding ProcessingElapsed, Mode=OneWay}" /> <Run Text="·  Remaining" /> <Run Text="{Binding ProcessingEta, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- ===== Upload ===== -->
                <Border Style="{StaticResource Card}" Padding="14,12" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Upload" Style="{StaticResource Txt.Heading}" />
                            <Button Content="{Binding RetryLabel}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Secondary}"
                                    HorizontalAlignment="Right" Padding="12,5" Margin="0"
                                    Visibility="{Binding CurrentEntry.CanRetry, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                        <TextBlock Text="{Binding UploadStateText}" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="{StaticResource Text}" />

                        <!-- Real bytes-sent progress; indeterminate when the total is unknown -->
                        <Grid Margin="0,8,0,0" Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="54" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar Value="{Binding JobPercent, Mode=OneWay}" Maximum="100"
                                         IsIndeterminate="{Binding JobPercentKnown, Converter={StaticResource InverseBool}}" />
                            <TextBlock Grid.Column="1" Text="{Binding JobPercentText}" FontWeight="Bold" TextAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding JobBytesText}" Style="{StaticResource FormHelp}"
                                   Visibility="{Binding JobBytesText, Converter={StaticResource TextToVisibility}}" />
                        <ProgressBar IsIndeterminate="True" Margin="0,8,0,0"
                                     Visibility="{Binding IsAssigning, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding CurrentEntry.ErrorMessage}" Style="{StaticResource BlockReason}" Foreground="{StaticResource Danger}"
                                   Visibility="{Binding CurrentEntry.HasError, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="{Binding RetryBlockReason}" Style="{StaticResource FormHelp}"
                                   Visibility="{Binding CurrentEntry.CanRetry, Converter={StaticResource BoolToVisibility}}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Open output" Command="{Binding OpenOutputCommand}" Style="{StaticResource Btn.Link}" />
                            <Button Content="Output folder" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource Btn.Link}" />
                            <Button Content="Release next demo card" Command="{Binding SimulateNextEntryCommand}" Style="{StaticResource Btn.Link}"
                                    Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="Reset demo" Command="{Binding ResetDemoCommand}" Style="{StaticResource Btn.Link}"
                                    Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ===== Next Entry ===== -->
                <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                            <TextBlock Text="Next Entry (Auto)" Style="{StaticResource Txt.Heading}" />
                            <TextBlock Text="Selected when the current entry completes." Style="{StaticResource Txt.Muted}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasNextEntry, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="Next:" Foreground="{StaticResource TextMuted}" />
                            <Run Text="Cart" FontWeight="SemiBold" /> <Run Text="{Binding NextEntry.CardNumber, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  •  " /> <Run Text="{Binding NextEntry.PrimaryName, Mode=OneWay}" FontWeight="SemiBold" />
                            <Run Text="  •  " /> <Run Text="{Binding NextEntry.PrimaryLocation, Mode=OneWay}" Foreground="{StaticResource TextMuted}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Txt.Muted}"
                                   Text="No pending entry. New entries from the server are picked up automatically."
                                   Visibility="{Binding HasNextEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
