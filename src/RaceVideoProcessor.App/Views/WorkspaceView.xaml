<UserControl x:Class="RaceVideoProcessor.App.Views.WorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A broadcast-production layout, top to bottom:
           TOP     race, category, upload · SELECT VIDEO · stage and progress · current → next
           MIDDLE  the video preview, with the scoreboard as rendered
           BOTTOM  the current cart and players, race timing and entry time, then upload
         The header and cart plate use the same Elegant Prestige package as the
         video scoreboard. Each piece of information has one home. -->
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- Fills the window; scrolls only when the window is too short for the layout. -->
        <Grid MinHeight="730" Height="{Binding ViewportHeight, ElementName=Scroller}">
          <Grid Margin="18,14,18,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="170" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ================= TOP: WORKFLOW ================= -->
            <Border Background="{StaticResource PrestigePanel}" BorderBrush="{StaticResource PrestigeEdge}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Race · category · upload -->
                    <Grid Margin="18,12,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding ActiveRaceName}" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource PrestigeText}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Foreground="{StaticResource PrestigeSub}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                <Run Text="{Binding ActiveRaceDate, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding SelectedCategoryLabel, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                            <RadioButton Style="{StaticResource PrestigeChip}" GroupName="Category" Content="200 Meter"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="Meter200"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Meter200}" />
                            <RadioButton Style="{StaticResource PrestigeChip}" GroupName="Category" Content="300 Meter"
                                         Command="{Binding SetCategoryCommand}" CommandParameter="Meter300"
                                         IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Meter300}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="UPLOAD" Foreground="{StaticResource PrestigeSub}" FontSize="12" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton Style="{StaticResource PrestigeChip}" GroupName="Upload" Content="ON"
                                         Command="{Binding SetUploadCommand}" CommandParameter="On"
                                         IsChecked="{Binding UploadEnabled, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=True}" />
                            <RadioButton Style="{StaticResource PrestigeChip}" GroupName="Upload" Content="OFF" Margin="0"
                                         Command="{Binding SetUploadCommand}" CommandParameter="Off"
                                         IsChecked="{Binding UploadEnabled, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=False}" />
                        </StackPanel>
                    </Grid>

                    <!-- Video selection and the job's status, on a light band for readability -->
                    <Border Grid.Row="1" Background="{StaticResource Surface}" Padding="18,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Content="SELECT VIDEO" Command="{Binding SelectVideoCommand}"
                                    Style="{StaticResource Btn.Primary}" VerticalAlignment="Center" Margin="0,0,16,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedVideoText}" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding SelectedEntry.LocalVideoPath}" />
                                <TextBlock Text="{Binding SelectVideoBlockReason}" Style="{StaticResource BlockReason}" Margin="0,3,0,0"
                                           Visibility="{Binding SelectVideoBlockReason, Converter={StaticResource TextToVisibility}}" />
                            </StackPanel>

                            <Button Grid.Column="2" Content="CANCEL PROCESSING" Command="{Binding CancelProcessingCommand}"
                                    Style="{StaticResource Btn.Danger}" VerticalAlignment="Center" Margin="12,0,0,0"
                                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Stage and progress -->
                            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Margin="0,0,14,0" Foreground="{StaticResource Text}">
                                    <Run Text="STAGE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                                    <Run Text="  " /><Run Text="{Binding StageText, Mode=OneWay}" FontSize="16" FontWeight="Bold" />
                                </TextBlock>
                                <ProgressBar Grid.Column="1" Minimum="0" Maximum="100" Height="10" VerticalAlignment="Center"
                                             Foreground="{StaticResource PrestigeLight}"
                                             Value="{Binding JobPercent, Mode=OneWay}"
                                             IsIndeterminate="{Binding JobPercentKnown, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=False}"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Foreground="{StaticResource TextMuted}"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                                    <Run Text="{Binding JobPercentText, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource Text}" FontSize="16" />
                                    <Run Text="{Binding JobBytesText, Mode=OneWay}" />
                                    <Run Text="{Binding ProcessingElapsed, Mode=OneWay}" />
                                    <Run Text="/" />
                                    <Run Text="{Binding ProcessingEta, Mode=OneWay}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Current → next -->
                    <Grid Grid.Row="2" Margin="18,10,18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{StaticResource PrestigeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                            <Run Text="CURRENT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Mindaro}" />
                            <Run Text="  Cart" /> <Run Text="{Binding CurrentCardText, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  " /><Run Text="{Binding CurrentNameText, Mode=OneWay}" Foreground="{StaticResource PrestigeSub}" />
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="→" FontSize="18" Foreground="{StaticResource PrestigeSub}" Margin="14,0" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Foreground="{StaticResource PrestigeText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="{Binding HasNextEntry, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="NEXT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Mindaro}" />
                            <Run Text="  Cart" /> <Run Text="{Binding NextEntry.CardNumber, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="  " /><Run Text="{Binding NextEntry.PrimaryDisplay, Mode=OneWay}" Foreground="{StaticResource PrestigeSub}" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" Foreground="{StaticResource PrestigeSub}" VerticalAlignment="Center"
                                   Visibility="{Binding HasNextEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                            <Run Text="NEXT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Mindaro}" />
                            <Run Text="  No pending entries" />
                        </TextBlock>
                    </Grid>

                    <!-- Mindaro bottom line, as on the scoreboard -->
                    <Border Grid.Row="2" Height="3" VerticalAlignment="Bottom" Background="{StaticResource MindaroLine}" />
                </Grid>
            </Border>

            <!-- ===== Messages ===== -->
            <StackPanel Grid.Row="1">
                <Border Margin="0,10,0,0" Padding="14,10" BorderThickness="1"
                        Background="{Binding BannerSeverity, Converter={StaticResource BannerBrush}, ConverterParameter=soft}"
                        BorderBrush="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}"
                        Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                                   Foreground="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}" />
                        <Button Grid.Column="1" Content="DISMISS" Command="{Binding DismissBannerCommand}"
                                Style="{StaticResource Btn.Secondary}" Margin="14,0,0,0" Padding="10,5" />
                    </Grid>
                </Border>
                <Border Margin="0,8,0,0" Padding="14,10" BorderThickness="1"
                        Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource Warning}"
                        Visibility="{Binding HasFontWarning, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding FontWarning}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                </Border>
            </StackPanel>

            <!-- ================= MIDDLE: VIDEO PREVIEW ================= -->
            <Border Grid.Row="2" Margin="0,10,0,0" Background="#0B0F0D" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PreviewCaption}" Foreground="{StaticResource PrestigeSub}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="Rendering…" Foreground="{StaticResource Mindaro}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="PREVIEW" Command="{Binding PreviewCommand}" Style="{StaticResource Btn.Secondary}"
                                    Padding="12,5" Margin="0" ToolTip="Render the selected video with the scoreboard" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="12,0,12,12" Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Image Source="{Binding PreviewNormalPath, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                        <Image Grid.Column="2" Source="{Binding PreviewFinalPath, Converter={StaticResource PathToImage}}" Stretch="Uniform" />
                        <TextBlock Grid.Row="1" Text="DURING THE RACE" Foreground="{StaticResource PrestigeSub}" FontSize="12"
                                   FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="FINAL SECONDS · TIMING" Foreground="{StaticResource PrestigeSub}"
                                   FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="No preview yet" Foreground="#7F8C84" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                </Grid>
            </Border>

            <!-- ================= BOTTOM: CURRENT ENTRY ================= -->
            <Border Grid.Row="3" Margin="0,10,0,0" Background="{StaticResource PrestigePanel}"
                    BorderBrush="{StaticResource PrestigeEdge}" BorderThickness="1">
                <Grid>
                    <!-- Empty state -->
                    <TextBlock Text="{Binding EmptyListText}" Foreground="{StaticResource PrestigeSub}" Margin="20,22"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasCurrentEntry, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <Grid Visibility="{Binding HasCurrentEntry, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="130" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Cart number: the entry identifier, in the scoreboard's centre column style -->
                        <Border Background="#B3021C12" BorderBrush="#8C9DDA72" BorderThickness="0,0,1,0" Padding="22,12">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="CART" Foreground="{StaticResource Mindaro}" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding CurrentEntry.CardNumber}" Foreground="{StaticResource PrestigeText}"
                                           FontFamily="Inter, Arial" FontSize="40" FontWeight="ExtraBold" HorizontalAlignment="Center" />
                                <Border Background="{Binding CurrentEntry.DisplayStatus, Converter={StaticResource StatusBrush}, ConverterParameter=soft}"
                                        Padding="8,2" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <TextBlock Style="{StaticResource Txt.Badge}"
                                               Foreground="{Binding CurrentEntry.DisplayStatus, Converter={StaticResource StatusBrush}}">
                                        <Run Text="{Binding CurrentEntry.StatusGlyph, Mode=OneWay}" /> <Run Text="{Binding CurrentEntry.StatusText, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Players -->
                        <Grid Grid.Column="1" Margin="22,12,16,12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="PRIMARY" Foreground="{StaticResource PrestigeSub}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding CurrentEntry.PrimaryName}" Foreground="{StaticResource PrestigeText}"
                                           FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="{Binding CurrentEntry.PrimaryDisplay}" />
                                <TextBlock Text="{Binding CurrentEntry.PrimaryLocation}" Foreground="{StaticResource PrestigeSub}"
                                           FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="SECONDARY" Foreground="{StaticResource PrestigeSub}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding CurrentEntry.SecondaryName}" Foreground="{StaticResource PrestigeText}"
                                           FontSize="22" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                           ToolTip="{Binding CurrentEntry.SecondaryDisplay}" />
                                <TextBlock Text="{Binding CurrentEntry.SecondaryLocation}" Foreground="{StaticResource PrestigeSub}"
                                           FontSize="15" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!-- Race timing and entry time -->
                        <Border Grid.Column="2" BorderBrush="#8C9DDA72" BorderThickness="1,0,0,0" Padding="22,12" MinWidth="200">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="RACE TIMING" Foreground="{StaticResource Mindaro}" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="{Binding CurrentEntry.TimingSecondsText}" Foreground="{StaticResource PrestigeText}"
                                           FontFamily="Inter, Arial" FontSize="26" FontWeight="Bold" />
                                <TextBlock Text="ENTRY TIME" Foreground="{StaticResource Mindaro}" FontSize="11" FontWeight="Bold" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding CurrentEntry.EntryDateDisplay}" Foreground="{StaticResource PrestigeText}" FontSize="16" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Height="3" VerticalAlignment="Bottom" Background="{StaticResource MindaroLine}" />
                </Grid>
            </Border>

            <!-- ================= UPLOAD ================= -->
            <Border Grid.Row="4" Margin="0,8,0,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" Padding="16,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                            <Run Text="UPLOAD" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" />
                            <Run Text="  " /><Run Text="{Binding UploadProgressText, Mode=OneWay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource Text}" />
                        </TextBlock>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UploadStateText}" Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="0,5,0,0" Foreground="{StaticResource PrestigeLight}"
                                         Value="{Binding JobPercent, Mode=OneWay}"
                                         Visibility="{Binding IsUploading, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar Minimum="0" Maximum="100" Height="8" Margin="0,5,0,0" Foreground="{StaticResource PrestigeLight}"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsAssigning, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <WrapPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Button Content="{Binding RetryLabel}" Command="{Binding RetryCommand}" Style="{StaticResource Btn.Secondary}"
                                    Padding="12,6" Margin="0,0,8,0"
                                    Visibility="{Binding SelectedEntry.CanRetry, Converter={StaticResource BoolToVisibility}}" />
                            <Button Content="OPEN OUTPUT" Command="{Binding OpenOutputCommand}" Style="{StaticResource Btn.Secondary}"
                                    Padding="12,6" Margin="0,0,8,0" />
                            <Button Content="FOLDER" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource Btn.Secondary}"
                                    Padding="12,6" Margin="0" />
                        </WrapPanel>
                    </Grid>

                    <TextBlock Text="{Binding CurrentEntry.ErrorMessage}" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,8,0,0"
                               Visibility="{Binding CurrentEntry.HasError, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding RetryBlockReason}" Style="{StaticResource BlockReason}" Margin="0,6,0,0"
                               Visibility="{Binding SelectedEntry.CanRetry, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Demo only -->
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                Visibility="{Binding IsDemoMode, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="DEMO" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="SIMULATE NEXT ENTRY" Command="{Binding SimulateNextEntryCommand}"
                                Style="{StaticResource Btn.Secondary}" Padding="12,5" Margin="0,0,8,0" />
                        <Button Content="RESET DEMO ARRIVAL" Command="{Binding ResetDemoCommand}"
                                Style="{StaticResource Btn.Secondary}" Padding="12,5" Margin="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
          </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
