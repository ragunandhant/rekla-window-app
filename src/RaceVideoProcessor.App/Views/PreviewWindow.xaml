<Window x:Class="RaceVideoProcessor.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Overlay preview"
        Width="1220" Height="820" MinWidth="800" MinHeight="600"
        Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource Size.Body}"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="CardText" Style="{StaticResource Txt.Display}" />
            <TextBlock x:Name="MetadataText" Style="{StaticResource Txt.Muted}" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource FormHelp}"
                       Text="This is rendered with the same filter chain as the final video. Check that Tamil names read correctly, that nothing collides with the card plate, and that the timing plaque sits where you expect." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="DURING THE RACE · SCOREBOARD" Style="{StaticResource Txt.Label}" Margin="0,0,0,10" />
                    <Image x:Name="NormalImage" Grid.Row="1" Stretch="Uniform" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="FINAL SECONDS · SCOREBOARD + TIMING" Style="{StaticResource Txt.Label}" Margin="0,0,0,10" />
                    <Image x:Name="FinalImage" Grid.Row="1" Stretch="Uniform" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CLOSE" Click="Close_Click" Margin="0" />
        </StackPanel>
    </Grid>
</Window>
