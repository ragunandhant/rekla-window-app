<UserControl x:Class="RaceVideoProcessor.App.Views.RacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,22">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">

            <TextBlock Text="Race Management" Style="{StaticResource Txt.Title}" />
            <TextBlock Style="{StaticResource Txt.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Each race has one Race ID from the backend. 200 Meter and 300 Meter both use it; only the type differs. Races are kept until you delete them, so you can switch between them freely." />

            <!-- Outcome banner, shared with the Work page -->
            <Border Margin="0,16,0,0" Padding="16,13" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                    Background="{Binding BannerSeverity, Converter={StaticResource BannerBrush}, ConverterParameter=soft}"
                    BorderBrush="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}"
                    Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                               Foreground="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}" />
                    <Button Grid.Column="1" Content="DISMISS" Command="{Binding DismissBannerCommand}"
                            Style="{StaticResource Btn.Secondary}" Margin="16,0,0,0" Padding="12,6" />
                </Grid>
            </Border>

            <!-- ===== Create new race ===== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                    Visibility="{Binding IsCreateRaceOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="CREATE NEW RACE" Style="{StaticResource Txt.Heading}" Foreground="{StaticResource Accent}" />
                    <Border Style="{StaticResource Divider}" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" MaxWidth="460" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Race Name" Style="{StaticResource FormLabel}" />
                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding NewRaceName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="For example: Kumbakonam Rekla Race" Style="{StaticResource FormHelp}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" MaxWidth="460" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Race Date" Style="{StaticResource FormLabel}" />
                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding NewRaceDate, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="DD-MM-YYYY, for example 13-09-2026. The date of the race itself." Style="{StaticResource FormHelp}" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" MaxWidth="460" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Race ID" Style="{StaticResource FormLabel}" />
                        <StackPanel Grid.Column="1">
                            <TextBox Text="{Binding NewRaceId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}" />
                            <TextBlock Text="Copy it from the backend, for example 6a8fa0dd70486e002831d000. One Race ID covers both 200 m and 300 m."
                                       Style="{StaticResource FormHelp}" />
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,8,0,0" Padding="14,11" CornerRadius="{StaticResource Radius.Control}"
                            Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                            Visibility="{Binding HasRaceFormError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding RaceFormError}" TextWrapping="Wrap" FontWeight="SemiBold"
                                       Foreground="{StaticResource Danger}" />
                            <StackPanel Visibility="{Binding HasDuplicateRace, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0">
                                <TextBlock Foreground="{StaticResource Text}" TextWrapping="Wrap">
                                    <Run Text="Existing race:" /> <Run Text="{Binding DuplicateRace.RaceName, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="·" /> <Run Text="{Binding DuplicateRace.RaceDateDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <Button Content="SELECT EXISTING RACE" Command="{Binding UseDuplicateRaceCommand}"
                                        Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,18,0,0">
                        <Button Content="SAVE RACE" Command="{Binding SaveRaceCommand}" Style="{StaticResource Btn.Primary}" Margin="0,0,10,0" />
                        <Button Content="CANCEL" Command="{Binding CancelCreateRaceCommand}" Style="{StaticResource Btn.Secondary}"
                                VerticalAlignment="Center" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ===== Saved races ===== -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SAVED RACES" Style="{StaticResource Txt.Heading}" Foreground="{StaticResource Accent}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ CREATE NEW RACE" Command="{Binding OpenCreateRaceCommand}" Margin="0" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />

                    <!-- Column headings -->
                    <Grid Margin="17,0,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="RACE NAME" Style="{StaticResource Txt.Label}" />
                        <TextBlock Grid.Column="1" Text="DATE" Style="{StaticResource Txt.Label}" />
                        <TextBlock Grid.Column="2" Text="RACE ID" Style="{StaticResource Txt.Label}" />
                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource Txt.Label}" />
                    </Grid>

                    <TextBlock Style="{StaticResource EmptyState}" HorizontalAlignment="Left" Margin="0,8"
                               Text="No races yet. Choose + CREATE NEW RACE and enter the Race ID from the backend."
                               Visibility="{Binding HasRaces, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <ListBox ItemsSource="{Binding Races}" SelectedItem="{Binding SelectedRaceItem, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource EntryRow}"
                             Visibility="{Binding HasRaces, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="100" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RaceName}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding RaceDateDisplay}" Style="{StaticResource Txt.Body}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding RaceId}" Style="{StaticResource Txt.Mono}"
                                               Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{StaticResource NeutralSoft}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Badge}" Foreground="{StaticResource Neutral}" />
                                    </Border>
                                    <Border Grid.Column="3" Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}"
                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="✓ ACTIVE" Style="{StaticResource Txt.Badge}" Foreground="{StaticResource Success}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="USE THIS RACE" Command="{Binding UseSelectedRaceCommand}" Style="{StaticResource Btn.Primary}"
                                Margin="0,0,10,8" />
                        <Button Content="DELETE RACE" Command="{Binding DeleteSelectedRaceCommand}" Style="{StaticResource Btn.Danger}"
                                VerticalAlignment="Center" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding UseRaceBlockReason}" Style="{StaticResource FormHelp}"
                               Visibility="{Binding UseRaceBlockReason, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Text="{Binding DeleteRaceBlockReason}" Style="{StaticResource BlockReason}"
                               Visibility="{Binding DeleteRaceBlockReason, Converter={StaticResource TextToVisibility}}" />
                    <TextBlock Style="{StaticResource FormHelp}"
                               Text="Deleting a race removes its saved configuration and all of its local records. Video files on disk and data on the backend are not touched." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
