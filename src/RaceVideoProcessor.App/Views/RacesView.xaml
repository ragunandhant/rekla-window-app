<UserControl x:Class="RaceVideoProcessor.App.Views.RacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="18,14,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title, search and actions -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Races" Style="{StaticResource Txt.Title}" />
                <TextBlock Text="One Race ID per race, shared by 200 Meter (type 200) and 300 Meter (type 300)." Style="{StaticResource Txt.Muted}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="240" Margin="0,0,10,0">
                    <TextBox Text="{Binding RaceSearchText, UpdateSourceTrigger=PropertyChanged}" Padding="10,7" />
                    <TextBlock Text="Search races…" Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0"
                               Visibility="{Binding RaceSearchText, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                </Grid>
                <Button Content="+  Add Race" Command="{Binding OpenCreateRaceCommand}" Padding="14,7" Margin="0" />
            </StackPanel>
        </Grid>

        <!-- Outcome banner -->
        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,9" CornerRadius="{StaticResource Radius.Control}" BorderThickness="1"
                Background="{Binding BannerSeverity, Converter={StaticResource BannerBrush}, ConverterParameter=soft}"
                BorderBrush="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}"
                Visibility="{Binding IsBannerVisible, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,30,0"
                           Foreground="{Binding BannerSeverity, Converter={StaticResource BannerBrush}}" />
                <Button Content="✕" Command="{Binding DismissBannerCommand}" Style="{StaticResource Btn.Link}" HorizontalAlignment="Right" Margin="0" />
            </Grid>
        </Border>

        <!-- Add / edit form -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"
                Visibility="{Binding IsCreateRaceOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="{Binding RaceFormTitle}" Style="{StaticResource Txt.Heading}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Race Name" Style="{StaticResource Txt.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewRaceName, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Race Date (DD-MM-YYYY)" Style="{StaticResource Txt.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewRaceDate, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Race ID (from the backend)" Style="{StaticResource Txt.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewRaceId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource MonoFont}"
                                 IsEnabled="{Binding IsEditingRace, Converter={StaticResource InverseBool}}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource FormHelp}"
                           Text="The Race ID is typed exactly as the backend has it; it is the race's identity, so it cannot be changed after saving."
                           Visibility="{Binding IsEditingRace, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,10,0,0" Padding="12,9" CornerRadius="{StaticResource Radius.Control}"
                        Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                        Visibility="{Binding HasRaceFormError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="{Binding RaceFormError}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{StaticResource Danger}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding HasDuplicateRace, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                <Run Text="Existing race:" /> <Run Text="{Binding DuplicateRace.RaceName, Mode=OneWay}" FontWeight="SemiBold" />
                            </TextBlock>
                            <Button Content="Select existing race" Command="{Binding UseDuplicateRaceCommand}" Style="{StaticResource Btn.Secondary}" Padding="10,5" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Save Race" Command="{Binding SaveRaceCommand}" Padding="16,7" />
                    <Button Content="Cancel" Command="{Binding CancelCreateRaceCommand}" Style="{StaticResource Btn.Secondary}" Padding="16,7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Races table -->
        <DataGrid Grid.Row="3" Margin="0,12,0,0" ItemsSource="{Binding VisibleRaces}"
                  SelectedItem="{Binding SelectedRaceItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Race Name" Width="2*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RaceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding RaceName}" />
                                <Border Style="{StaticResource Badge}" Background="{StaticResource SuccessSoft}" Margin="8,0,0,0" Padding="7,1"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="✓ Active" Style="{StaticResource Txt.Badge}" Foreground="{StaticResource Success}" />
                                </Border>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Race Date" Binding="{Binding RaceDateDisplay}" Width="110" />
                <DataGridTemplateColumn Header="Race ID" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RaceId}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMuted}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RaceId}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Total Entries" Binding="{Binding TotalEntries}" Width="100" />
                <DataGridTextColumn Header="200M" Binding="{Binding Entries200}" Width="70" />
                <DataGridTextColumn Header="300M" Binding="{Binding Entries300}" Width="70" />
                <DataGridTemplateColumn Header="Actions" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Select" Style="{StaticResource Btn.Link}"
                                        Command="{Binding DataContext.SelectRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Edit" Style="{StaticResource Btn.Link}"
                                        Command="{Binding DataContext.EditRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Delete" Style="{StaticResource Btn.Link}" Foreground="{StaticResource Danger}"
                                        Command="{Binding DataContext.DeleteRaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource Txt.Muted}"
                       Text="Entry counts are the records stored locally. Deleting a race removes its local records only; video files and backend data are untouched." />
            <TextBlock Text="{Binding RaceCountText}" Style="{StaticResource Txt.Muted}" HorizontalAlignment="Right" />
        </Grid>
    </Grid>
</UserControl>
