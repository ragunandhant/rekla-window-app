<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         Palette — built for a laptop screen in direct sunlight.

         Light ground, near-black text, solid borders. Every foreground
         here clears 4.5:1 against the surface it is used on, and the
         primary text pair clears 12:1, because washed-out grey-on-grey
         is unreadable outdoors. No transparency is used for anything
         that carries meaning.
         ============================================================ -->

    <Color x:Key="C.Canvas">#E9EDF4</Color>
    <Color x:Key="C.Surface">#FFFFFF</Color>
    <Color x:Key="C.SurfaceAlt">#F5F8FC</Color>
    <Color x:Key="C.SurfaceSunken">#EDF1F7</Color>
    <Color x:Key="C.Border">#BCC7D8</Color>
    <Color x:Key="C.BorderStrong">#8593AB</Color>

    <Color x:Key="C.Text">#0D1524</Color>
    <Color x:Key="C.TextMuted">#41516A</Color>
    <Color x:Key="C.TextFaint">#5A6980</Color>
    <Color x:Key="C.OnAccent">#FFFFFF</Color>

    <Color x:Key="C.Accent">#0B57C8</Color>
    <Color x:Key="C.AccentDark">#083F92</Color>
    <Color x:Key="C.Success">#0A7A3D</Color>
    <Color x:Key="C.Warning">#8A5200</Color>
    <Color x:Key="C.Danger">#B3261E</Color>
    <Color x:Key="C.Info">#0B57C8</Color>
    <Color x:Key="C.Neutral">#41516A</Color>

    <!-- Badge and banner fills: tinted, never transparent. -->
    <Color x:Key="C.AccentSoft">#DEEAFB</Color>
    <Color x:Key="C.SuccessSoft">#DCF2E4</Color>
    <Color x:Key="C.WarningSoft">#FBEDD6</Color>
    <Color x:Key="C.DangerSoft">#FADEDC</Color>
    <Color x:Key="C.InfoSoft">#DEEAFB</Color>
    <Color x:Key="C.NeutralSoft">#E3E8F0</Color>

    <SolidColorBrush x:Key="Canvas" Color="{StaticResource C.Canvas}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource C.Surface}" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="{StaticResource C.SurfaceAlt}" />
    <SolidColorBrush x:Key="SurfaceSunken" Color="{StaticResource C.SurfaceSunken}" />
    <SolidColorBrush x:Key="Border" Color="{StaticResource C.Border}" />
    <SolidColorBrush x:Key="BorderStrong" Color="{StaticResource C.BorderStrong}" />

    <SolidColorBrush x:Key="Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="TextMuted" Color="{StaticResource C.TextMuted}" />
    <SolidColorBrush x:Key="TextFaint" Color="{StaticResource C.TextFaint}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource C.OnAccent}" />

    <SolidColorBrush x:Key="Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="AccentDark" Color="{StaticResource C.AccentDark}" />
    <SolidColorBrush x:Key="Success" Color="{StaticResource C.Success}" />
    <SolidColorBrush x:Key="Warning" Color="{StaticResource C.Warning}" />
    <SolidColorBrush x:Key="Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="Info" Color="{StaticResource C.Info}" />
    <SolidColorBrush x:Key="Neutral" Color="{StaticResource C.Neutral}" />

    <SolidColorBrush x:Key="AccentSoft" Color="{StaticResource C.AccentSoft}" />
    <SolidColorBrush x:Key="SuccessSoft" Color="{StaticResource C.SuccessSoft}" />
    <SolidColorBrush x:Key="WarningSoft" Color="{StaticResource C.WarningSoft}" />
    <SolidColorBrush x:Key="DangerSoft" Color="{StaticResource C.DangerSoft}" />
    <SolidColorBrush x:Key="InfoSoft" Color="{StaticResource C.InfoSoft}" />
    <SolidColorBrush x:Key="NeutralSoft" Color="{StaticResource C.NeutralSoft}" />

    <!-- ============================================================
         Typography

         Nirmala UI leads the stack because it covers Tamil and ships
         with Windows; Segoe UI follows for Latin-only systems. WPF
         falls through this list per glyph, so mixed Tamil/Latin text
         renders without boxes.
         ============================================================ -->
    <FontFamily x:Key="UiFont">Nirmala UI, Noto Sans Tamil, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- Sizes run large on purpose: small type is the first thing lost in glare. -->
    <sys:Double x:Key="Size.Card">32</sys:Double>
    <sys:Double x:Key="Size.Display">26</sys:Double>
    <sys:Double x:Key="Size.Title">20</sys:Double>
    <sys:Double x:Key="Size.Heading">16</sys:Double>
    <sys:Double x:Key="Size.Body">14</sys:Double>
    <sys:Double x:Key="Size.Small">13</sys:Double>
    <sys:Double x:Key="Size.Micro">12</sys:Double>

    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- Elegant Prestige: the broadcast graphics package, shared by the video
         scoreboard and the workspace, so both read as one visual system. -->
    <Color x:Key="C.PrestigeDark">#031A11</Color>
    <Color x:Key="C.Prestige">#063322</Color>
    <Color x:Key="C.PrestigeMid">#0A442D</Color>
    <Color x:Key="C.PrestigeLight">#0D5A3B</Color>
    <Color x:Key="C.PrestigeEdge">#56BE8B</Color>
    <Color x:Key="C.Mindaro">#D9F24F</Color>
    <Color x:Key="C.PrestigeText">#F5F5ED</Color>
    <Color x:Key="C.PrestigeSub">#D9E1D9</Color>
    <SolidColorBrush x:Key="PrestigeDark" Color="{StaticResource C.PrestigeDark}" />
    <SolidColorBrush x:Key="Prestige" Color="{StaticResource C.Prestige}" />
    <SolidColorBrush x:Key="PrestigeMid" Color="{StaticResource C.PrestigeMid}" />
    <SolidColorBrush x:Key="PrestigeLight" Color="{StaticResource C.PrestigeLight}" />
    <SolidColorBrush x:Key="PrestigeEdge" Color="{StaticResource C.PrestigeEdge}" />
    <SolidColorBrush x:Key="Mindaro" Color="{StaticResource C.Mindaro}" />
    <SolidColorBrush x:Key="PrestigeText" Color="{StaticResource C.PrestigeText}" />
    <SolidColorBrush x:Key="PrestigeSub" Color="{StaticResource C.PrestigeSub}" />
    <LinearGradientBrush x:Key="PrestigePanel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B4A31" Offset="0" />
        <GradientStop Color="#073522" Offset="0.48" />
        <GradientStop Color="#032016" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="MindaroLine" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#C7E947" Offset="0" />
        <GradientStop Color="#D9F24F" Offset="0.5" />
        <GradientStop Color="#C7E947" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
