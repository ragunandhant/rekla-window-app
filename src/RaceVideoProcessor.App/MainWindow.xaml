<Window x:Class="RaceVideoProcessor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RaceVideoProcessor.App.Views"
        Title="Race Video Processor"
        Width="1500" Height="950" MinWidth="900" MinHeight="560"
        Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource Size.Body}"
        ResizeMode="CanResize"
        UseLayoutRounding="True">

    <!-- Standard Windows chrome: minimise, maximise, snap and per-monitor DPI come from the OS. -->

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Control" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Control" Key="D0" Command="{Binding ResetZoomCommand}" />
        <KeyBinding Modifiers="Control" Key="NumPad0" Command="{Binding ResetZoomCommand}" />
    </Window.InputBindings>

    <!-- Zoom scales the whole interface, header included. It never touches the video. -->
    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiZoom}" ScaleY="{Binding UiZoom}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Header: workflow controls left, navigation right ================= -->
        <Border Background="{StaticResource Header}">
            <Grid Margin="14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,3,22,3">
                        <TextBlock Text="Race" Style="{StaticResource HeaderLabel}" />
                        <ComboBox Width="250" Padding="9,5" VerticalAlignment="Center"
                                  ItemsSource="{Binding Races}" SelectedItem="{Binding HeaderRace, Mode=TwoWay}"
                                  ToolTip="Switch the race. Refused while an operation is running.">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding RaceName}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,22,3">
                        <TextBlock Text="Category" Style="{StaticResource HeaderLabel}" />
                        <RadioButton Style="{StaticResource HeaderChip}" GroupName="Category" Content="200 Meter"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Meter200"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Meter200}" />
                        <RadioButton Style="{StaticResource HeaderChip}" GroupName="Category" Content="300 Meter"
                                     Command="{Binding SetCategoryCommand}" CommandParameter="Meter300"
                                     IsChecked="{Binding SelectedCategory, Mode=OneWay, Converter={StaticResource EqualsParam}, ConverterParameter=Meter300}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,22,3" ToolTip="{Binding WorkflowModeText}">
                        <TextBlock Text="Processing" Style="{StaticResource HeaderLabel}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding ProcessingEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Processing" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,3,0,3" ToolTip="{Binding WorkflowModeText}">
                        <TextBlock Text="Upload" Style="{StaticResource HeaderLabel}" />
                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UploadEnabled, Mode=TwoWay}"
                                  AutomationProperties.Name="Upload" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Page" Content="Races"
                                 Command="{Binding NavigateCommand}" CommandParameter="Races"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Races}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Page" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Settings}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Page" Content="Logs"
                                 Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Logs}" />
                    <RadioButton Style="{StaticResource NavTab}" GroupName="Page" Content="Database"
                                 Command="{Binding NavigateCommand}" CommandParameter="Database"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Database}" />

                    <Border Width="1" Background="{StaticResource HeaderEdge}" Margin="10,4" />

                    <Button Style="{StaticResource HeaderIconButton}" Content="−" Command="{Binding ZoomOutCommand}" ToolTip="Zoom out (Ctrl −)" />
                    <TextBlock Text="{Binding UiZoom, Converter={StaticResource ZoomPercent}}" Width="42" TextAlignment="Center"
                               Foreground="{StaticResource HeaderText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Style="{StaticResource HeaderIconButton}" Content="+" Command="{Binding ZoomInCommand}" ToolTip="Zoom in (Ctrl +)" />
                    <Button Style="{StaticResource Btn.Link}" Content="Reset" Command="{Binding ResetZoomCommand}"
                            Foreground="{StaticResource HeaderSub}" Margin="8,0,0,0" VerticalAlignment="Center"
                            ToolTip="Reset zoom (Ctrl 0)"
                            Visibility="{Binding IsZoomChanged, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Pages ================= -->
        <Grid Grid.Row="1">
            <views:WorkspaceView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Work}" />
            <views:RacesView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Races}" />
            <views:SettingsView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Settings}" />
            <views:LogsView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Logs}" />
            <views:DatabaseView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Database}" />
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Height="28" Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Dot}" Width="9" Height="9"
                             Fill="{Binding IsBusy, Converter={StaticResource ConnectedBrush}, ConverterParameter=busy}" />
                    <TextBlock Text="{Binding StatusBarText}" Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Style="{StaticResource Dot}" Width="8" Height="8"
                             Fill="{Binding IsApiConnected, Converter={StaticResource ConnectedBrush}}" />
                    <TextBlock Style="{StaticResource Txt.Muted}" VerticalAlignment="Center">
                        <Run Text="{Binding ModeLabel, Mode=OneWay}" /> <Run Text="·" /> <Run Text="{Binding ApiStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="  |  SQLite  |  " Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding EncoderDisplay}" Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="  |  " Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
