<Window x:Class="RaceVideoProcessor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RaceVideoProcessor.App.Views"
        Title="Race Video Processor"
        Width="1500" Height="950" MinWidth="900" MinHeight="560"
        Background="{StaticResource Canvas}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}"
        FontSize="{StaticResource Size.Body}"
        ResizeMode="CanResize"
        UseLayoutRounding="True">

    <!-- The window keeps the standard Windows chrome: minimise, maximise/restore,
         close, double-click-to-maximise, snap and per-monitor DPI all come from
         the OS and behave exactly as they do in any other desktop application. -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Top bar ================= -->
        <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <DockPanel Height="60" Margin="20,0" LastChildFill="True">

                <!-- Docked first, so these keep their space at any window width. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource PageTab}" GroupName="Page" Content="Work"
                                 Command="{Binding NavigateCommand}" CommandParameter="Work"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Work}" />
                    <RadioButton Style="{StaticResource PageTab}" GroupName="Page" Content="Settings"
                                 Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Settings}" />
                    <RadioButton Style="{StaticResource PageTab}" GroupName="Page" Content="Logs"
                                 Command="{Binding NavigateCommand}" CommandParameter="Logs"
                                 IsChecked="{Binding ActivePage, Mode=OneWay, Converter={StaticResource PageToBool}, ConverterParameter=Logs}" />
                    <Button Content="POLL NOW" Command="{Binding PollNowCommand}"
                            Style="{StaticResource Btn.Secondary}" Margin="10,0,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Left" Text="RACE VIDEO PROCESSOR" Style="{StaticResource Txt.Heading}"
                           VerticalAlignment="Center" Margin="0,0,18,0" />

                <!-- Fills what is left; the least critical items give way first. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
                    <Border Style="{StaticResource Badge}" Background="{StaticResource NeutralSoft}" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ModeLabel}" Style="{StaticResource Txt.Badge}"
                                   Foreground="{StaticResource Neutral}" />
                    </Border>
                    <Ellipse Style="{StaticResource Dot}" Fill="{Binding IsApiConnected, Converter={StaticResource ConnectedBrush}}" />
                    <TextBlock Text="{Binding ApiStatusText}" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource Text}" Margin="0,0,18,0" />
                    <TextBlock Text="Last sync" Style="{StaticResource Txt.Label}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding LastSyncText}" VerticalAlignment="Center" Margin="7,0,0,0"
                               Foreground="{StaticResource Text}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ================= Body ================= -->
        <Grid Grid.Row="1">

            <!-- ========== Work: entry list + workspace ========== -->
            <Grid Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Work}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="370" MinWidth="250" MaxWidth="620" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <!-- Entry list. Always visible, always navigable: nothing in this
                     panel is ever disabled because of another entry's state. -->
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <Grid Margin="16,16,10,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ENTRIES" Style="{StaticResource Txt.Title}" />
                            <TextBlock Grid.Column="1" Text="{Binding EntryCountSummary}" Style="{StaticResource Txt.Muted}"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Search: card number, player, location, user id, file name -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="Search card, name, location, user id…"
                                       Foreground="{StaticResource TextFaint}" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="13,0,0,0"
                                       Visibility="{Binding SearchText, Converter={StaticResource TextToVisibility}, ConverterParameter=invert}" />
                        </Grid>

                        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="All"
                                         Command="{Binding SetFilterCommand}" CommandParameter="All"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=All}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Ready"
                                         Command="{Binding SetFilterCommand}" CommandParameter="Ready"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Ready}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="No video"
                                         Command="{Binding SetFilterCommand}" CommandParameter="NoVideo"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=NoVideo}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Pending"
                                         Command="{Binding SetFilterCommand}" CommandParameter="Pending"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Pending}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Processing"
                                         Command="{Binding SetFilterCommand}" CommandParameter="Processing"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Processing}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Completed"
                                         Command="{Binding SetFilterCommand}" CommandParameter="Completed"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Completed}" />
                            <RadioButton Style="{StaticResource Chip}" GroupName="Filter" Content="Failed"
                                         Command="{Binding SetFilterCommand}" CommandParameter="Failed"
                                         IsChecked="{Binding Filter, Mode=OneWay, Converter={StaticResource FilterToBool}, ConverterParameter=Failed}" />
                        </WrapPanel>

                        <TextBlock Grid.Row="3" Style="{StaticResource EmptyState}" VerticalAlignment="Top"
                                   Text="No entries match. Clear the search or filter, or release the next demo entry."
                                   Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding VisibleEntries}"
                                 SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource EntryRow}"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 Visibility="{Binding HasVisibleEntries, Converter={StaticResource BoolToVisibility}}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- The card number is the entry identifier, so it leads. -->
                                        <TextBlock Text="{Binding CardNumber}" FontSize="17" FontWeight="Bold"
                                                   Foreground="{StaticResource Text}" />

                                        <Border Grid.Column="1" Style="{StaticResource Badge}"
                                                Background="{Binding DisplayStatus, Converter={StaticResource StatusBrush}, ConverterParameter=soft}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StatusGlyph}" Style="{StaticResource Txt.Badge}"
                                                           Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}"
                                                           Margin="0,0,5,0" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Txt.Badge}"
                                                           Foreground="{Binding DisplayStatus, Converter={StaticResource StatusBrush}}" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding PrimaryDisplay}"
                                                   Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="1" />

                <views:WorkspaceView Grid.Column="2" />
            </Grid>

            <!-- ========== Settings ========== -->
            <views:SettingsView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Settings}" />

            <!-- ========== Logs ========== -->
            <views:LogsView Visibility="{Binding ActivePage, Converter={StaticResource PageToVisibility}, ConverterParameter=Logs}" />
        </Grid>

        <!-- ================= Status bar ================= -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Height="34" Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Ellipse Style="{StaticResource Dot}" Width="8" Height="8"
                             Fill="{Binding IsApiConnected, Converter={StaticResource ConnectedBrush}}" />
                    <TextBlock Text="{Binding ApiStatusText}" Style="{StaticResource Txt.Muted}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0"
                           Style="{StaticResource Txt.Muted}" Text="{Binding ProcessingSummary}" />

                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,24,0"
                           Style="{StaticResource Txt.Muted}" Text="{Binding EncoderDisplay}" />

                <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Txt.Muted}"
                           Text="{Binding FontDisplay}" />
            </Grid>
        </Border>
    </Grid>
</Window>
